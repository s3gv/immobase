# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Fester Wert für die Entwicklung. Ohne ihn wird bei jedem Containerstart ein
# neuer erzeugt und alle Sitzungen sind ungültig — man ist nach jedem Neustart
# abgemeldet. install.sh erzeugt für echte Installationen einen zufälligen Wert
# in .env.local, der diesen hier überschreibt.
APP_SECRET=dev-only-not-a-secret-0000000000000000
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# Entwicklungsvorgabe, passend zu compose.override.yaml. Produktiv erzeugt
# install.sh eine .env.local mit echten Zugangsdaten; diese Datei enthält nur
# lokale Vorgaben und niemals Geheimnisse.
DATABASE_URL="postgresql://immobase:immobase@127.0.0.1:5432/immobase?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> immobase ###
POSTGRES_DB=immobase
POSTGRES_USER=immobase
POSTGRES_PASSWORD=immobase
APP_LOCALE=de
# Hintergrundgrafik: "auto" wählt pro Sitzung ein zufälliges Bundesland.
# Alternativ ein fester Dateiname aus assets/images/regions/ ohne .svg.
IMMOBASE_REGION=auto

# AGPL §13: Adresse, unter der der Quellcode DIESER Installation liegt.
# Wer ImmoBase verändert, trägt hier sein eigenes Repository ein — die
# Lizenz verlangt den Quellcode der laufenden Fassung, nicht den der
# ursprünglichen.
IMMOBASE_SOURCE_URL=https://github.com/s3gv/immobase
APP_VERSION=1.0.0
APP_COMMIT=unknown
###< immobase ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Ohne Mailserver: null://null verschickt nichts. Die Anwendung erkennt das
# und zeigt Einladungslinks stattdessen zum Kopieren an, statt still ins Leere
# zu senden. install.sh fragt echte Zugangsdaten ab und schreibt sie nach
# .env.local.
MAILER_DSN=null://null

###> immobase/portal ###
# Der Schlüssel für die Anhänge im Mieterportal: 32 Byte, base64.
#
# Er verschlüsselt die Dateien in der Datenbank. Ohne ihn nimmt das Portal
# keine Anhänge an — es legt sie nicht ersatzweise im Klartext ab.
#
# Erzeugen mit:  head -c 32 /dev/urandom | base64
#
# Wechseln macht die noch gespeicherten Anhänge unlesbar. Das ist zu
# verschmerzen: sie leben ohnehin nur Tage.
#
# **Bewusst ohne Zuweisung.** Diese Datei liest nicht nur Symfony, sondern auch
# Docker Compose — und eine Variable, die dort leer definiert ist, landet als
# leere Umgebungsvariable im Container. Symfony überschreibt nichts, was schon
# in der Umgebung steht; der Schlüssel aus .env.local käme dann nie an. Ohne
# Zuweisung greift die Vorgabe aus config/services.yaml.
# IMMOBASE_FILE_KEY=
###< immobase/portal ###
MAILER_FROM=immobase@localhost
###< symfony/mailer ###
