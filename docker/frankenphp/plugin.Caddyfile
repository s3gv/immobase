#
# Ein Plugin-Prozess: nur an 127.0.0.1, schlichtes HTTP, ohne
# Verwaltungsschnittstelle. Port und Wurzel setzt der Core beim Start.
{
	admin off

	servers {
		protocols h1 h2c
	}
}

:{$IMMOBASE_PLUGIN_PORT} {
	bind 127.0.0.1
	root {$IMMOBASE_PLUGIN_ROOT}
	encode zstd br gzip

	php_server
}
