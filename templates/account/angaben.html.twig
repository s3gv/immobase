{% embed 'components/sections.html.twig' %}
    {% block section_body %}
        <form method="post" action="{{ path('app_account_profile') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('account_profile') }}">

            {% include 'components/field.html.twig' with {
                id: 'givenName', name: 'givenName', label: 'user.field.given_name'|trans,
                value: user.name.givenName, required: true, autocomplete: 'given-name'
            } only %}
            {% include 'components/field.html.twig' with {
                id: 'familyName', name: 'familyName', label: 'user.field.family_name'|trans,
                value: user.name.familyName, required: true, autocomplete: 'family-name'
            } only %}
            {% include 'components/field.html.twig' with {
                id: 'jobTitle', name: 'jobTitle', label: 'user.field.job_title'|trans,
                hint: 'user.field.job_title_hint'|trans,
                value: user.name.jobTitle, placeholder: 'user.field.job_title_example'|trans
            } only %}

            <div class="ib-flow__actions">
                <button class="ib-button" type="submit">{{ 'settings.save'|trans }}</button>
            </div>
        </form>
    {% endblock %}
{% endembed %}
