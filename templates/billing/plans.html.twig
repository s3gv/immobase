{#
    Alle Wirtschaftspläne, die neuesten zuerst.

    Entwürfe stehen mit in der Liste und tragen ihren Status: sie sind
    angefangene Arbeit und gehören vor Augen.
#}
{% extends 'shell.html.twig' %}

{% block title %}{{ 'billing.plan.heading'|trans }} · {{ 'app.name'|trans }}{% endblock %}

{% block content %}
    <h1 class="ib-heading">{{ 'billing.plan.heading'|trans }}</h1>
    <p class="ib-subheading">{{ 'billing.plan.subheading'|trans }}</p>

    {% embed 'components/index_page.html.twig' with {
        headers: [
            'billing.plan.reference'|trans,
            'billing.plan.fiscal_year'|trans,
            'billing.plan.label'|trans,
            'billing.plan.units'|trans,
            'billing.plan.status'|trans
        ],
        rows: plans|map(p => {
            cells: [
                'WP-' ~ p.propertyNumber ~ '-' ~ p.period.year ~ '-' ~ p.edition.number ~ (p.edition.iteration > 1 ? '-' ~ p.edition.iteration : ''),
                p.period.year,
                p.label ?: 'billing.plan.unnamed'|trans,
                p.documents|length,
                p.stage.status.labelKey|trans
            ],
            actions: (p.stage.isOpen
                ? (is_granted('billing.edit')
                    ? [
                        { action: 'edit', url: path('app_billing_plan_edit', { id: p.id, step: 'wirtschaftsplan' }) },
                        { action: 'delete', modal: 'billing-plan-delete-' ~ p.id }
                      ]
                    : [])
                : [
                    { action: 'open', url: path('app_billing_plan_show', { id: p.id }) },
                    { action: 'download', url: path('app_billing_plan_pdf', { id: p.id }) }
                  ])
        }),
        page: page,
        action: path('app_billing_plan'),
        url: url,
        empty: 'billing.plan.empty'|trans,
        plans: plans,
        filter: filter,
        properties: properties,
        years: years,
        statuses: statuses
    } only %}
        {% block actions %}
            {% if is_granted('billing.edit') %}
                {% include 'components/action.html.twig' with {
                    action: 'add', url: path('app_billing_plan_new'), labelled: true
                } only %}
            {% endif %}
        {% endblock %}

        {% block filters %}
            {% include 'components/field.html.twig' with {
                id: 'q', name: 'q', label: 'billing.statement.filter.search'|trans,
                value: filter.search, placeholder: 'billing.statement.filter.search_hint'|trans
            } only %}

            {% include 'components/select.html.twig' with {
                id: 'objekt', name: 'objekt', label: 'billing.plan.property'|trans,
                choices: properties|map(p => { value: p.number, label: p.oneLine }),
                value: filter.propertyNumber, blank: 'billing.statement.filter.all_properties'|trans
            } only %}

            {% include 'components/select.html.twig' with {
                id: 'jahr', name: 'jahr', label: 'billing.plan.fiscal_year'|trans,
                choices: years|map(y => { value: y, label: y }),
                value: filter.fiscalYear, blank: 'billing.statement.filter.all_years'|trans
            } only %}

            {% include 'components/select.html.twig' with {
                id: 'zustand', name: 'zustand', label: 'billing.plan.status'|trans,
                choices: statuses|map(s => { value: s.value, label: s.labelKey|trans }),
                value: filter.status ? filter.status.value : '',
                blank: 'billing.statement.filter.all_states'|trans
            } only %}
        {% endblock %}
    {% endembed %}

    {#
        Gelöscht wird nur ein Entwurf, und auch der mit Rückfrage: die Zeilen
        von drei Schritten sind Arbeit. Freigegebene Pläne haben gar keinen
        Knopf — auf ihnen stehen Forderungen.
    #}
    {% for p in plans %}
        {% if p.stage.isOpen and is_granted('billing.edit') %}
            {% include 'components/confirm.html.twig' with {
                id: 'billing-plan-delete-' ~ p.id,
                title: 'billing.plan.delete.title'|trans,
                body: 'billing.plan.delete.body'|trans,
                url: path('app_billing_plan_delete', { id: p.id }),
                token: 'billing'
            } only %}
        {% endif %}
    {% endfor %}
{% endblock %}
