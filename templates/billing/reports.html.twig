{#
    Alle Vermögensberichte, die neuesten zuerst.

    Entwürfe stehen mit in der Liste und tragen ihren Status: sie sind
    angefangene Arbeit und gehören vor Augen.
#}
{% extends 'shell.html.twig' %}

{% block title %}{{ 'billing.report.heading'|trans }} · {{ 'app.name'|trans }}{% endblock %}

{% block content %}
    <h1 class="ib-heading">{{ 'billing.report.heading'|trans }}</h1>
    <p class="ib-subheading">{{ 'billing.report.subheading'|trans }}</p>

    {% embed 'components/index_page.html.twig' with {
        headers: [
            'billing.report.reference'|trans,
            'billing.report.fiscal_year'|trans,
            'billing.report.label'|trans,
            'billing.report.units'|trans,
            'billing.report.status'|trans
        ],
        rows: reports|map(r => {
            cells: [
                'VB-' ~ r.propertyNumber ~ '-' ~ r.period.year ~ '-' ~ r.edition.number ~ (r.edition.iteration > 1 ? '-' ~ r.edition.iteration : ''),
                r.period.year,
                r.label ?: 'billing.report.unnamed'|trans,
                r.documents|length,
                ('billing.report.state.' ~ r.release.status.value)|trans
            ],
            actions: (r.release.isDraft
                ? (is_granted('billing.edit')
                    ? [
                        { action: 'edit', url: path('app_billing_report_edit', { id: r.id, step: 'vermoegensbericht' }) },
                        { action: 'delete', modal: 'billing-report-delete-' ~ r.id }
                      ]
                    : [])
                : [
                    { action: 'open', url: path('app_billing_report_show', { id: r.id }) },
                    { action: 'download', url: path('app_billing_report_pdf', { id: r.id }) }
                  ])
        }),
        page: page,
        action: path('app_billing_report'),
        url: url,
        empty: 'billing.report.empty'|trans,
        filter: filter,
        properties: properties,
        years: years,
        statuses: statuses
    } only %}
        {% block actions %}
            {% if is_granted('billing.edit') %}
                {% include 'components/action.html.twig' with {
                    action: 'add', url: path('app_billing_report_new'), labelled: true
                } only %}
            {% endif %}
        {% endblock %}

        {% block filters %}
            {% include 'components/field.html.twig' with {
                id: 'q', name: 'q', label: 'billing.statement.filter.search'|trans,
                value: filter.search, placeholder: 'billing.statement.filter.search_hint'|trans
            } only %}

            {% include 'components/select.html.twig' with {
                id: 'objekt', name: 'objekt', label: 'billing.report.property'|trans,
                choices: properties|map(p => { value: p.number, label: p.oneLine }),
                value: filter.propertyNumber, blank: 'billing.statement.filter.all_properties'|trans
            } only %}

            {% include 'components/select.html.twig' with {
                id: 'jahr', name: 'jahr', label: 'billing.report.filter.year'|trans,
                choices: years|map(y => { value: y, label: y }),
                value: filter.fiscalYear, blank: 'billing.statement.filter.all_years'|trans
            } only %}

            {% include 'components/select.html.twig' with {
                id: 'zustand', name: 'zustand', label: 'billing.report.status'|trans,
                choices: statuses|map(s => { value: s.value, label: ('billing.report.state.' ~ s.value)|trans }),
                value: filter.status ? filter.status.value : '',
                blank: 'billing.statement.filter.all_states'|trans
            } only %}
        {% endblock %}
    {% endembed %}

    {#
        Gelöscht wird nur ein Entwurf, und auch der mit Rückfrage. Ein
        herausgegebener Bericht hat gar keinen Knopf — er ist zugestellt.
    #}
    {% for r in reports %}
        {% if r.release.isDraft and is_granted('billing.edit') %}
            {% include 'components/confirm.html.twig' with {
                id: 'billing-report-delete-' ~ r.id,
                title: 'billing.report.delete.title'|trans,
                body: 'billing.report.delete.body'|trans,
                url: path('app_billing_report_delete', { id: r.id }),
                token: 'billing'
            } only %}
        {% endif %}
    {% endfor %}
{% endblock %}
