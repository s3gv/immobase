{# Erwartet `trail` als Liste von { label, url } — der letzte Eintrag ohne url. #}
<nav class="ib-breadcrumb" aria-label="{{ 'shell.breadcrumb'|trans }}">
    <ol>
        {% for crumb in trail %}
            <li>
                {% if crumb.url is defined and crumb.url %}
                    <a href="{{ crumb.url }}">{{ crumb.label }}</a>
                {% else %}
                    <span aria-current="page">{{ crumb.label }}</span>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
</nav>
