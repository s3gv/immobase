{#
    Ein Symbol.

    Erwartet: name — Dateiname aus assets/images/icons/ ohne .svg

    Eingebettet statt per <img> geladen, damit stroke/fill="currentColor" die
    Textfarbe erbt und mit dem Theme wechselt. Ein per <img> geladenes SVG ist
    ein eigenes Dokument und kann das nicht.
#}
<span class="ib-icon">{{ source('@icons/' ~ name ~ '.svg')|raw }}</span>
