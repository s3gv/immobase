{#
    Die Zinsstaffel.

    Betrag, Satz und Tage stehen einzeln da und nicht nur ihr Ergebnis: wer
    eine Zinsforderung bestreitet, bestreitet einen dieser vier Werte.

    Erwartet: schedule — App\Module\Dunning\Domain\InterestSchedule
#}
{% if schedule.isEmpty %}
    <p class="ib-muted">{{ 'dunning.schedule_empty'|trans }}</p>
{% else %}
    <div class="ib-table-scroll">
        <table class="ib-table ib-table--compact">
            <thead>
                <tr>
                    <th>{{ 'dunning.period'|trans }}</th>
                    <th class="ib-table__number">{{ 'dunning.open'|trans }}</th>
                    <th class="ib-table__number">{{ 'dunning.base_rate'|trans }}</th>
                    <th class="ib-table__number">{{ 'dunning.points'|trans }}</th>
                    <th class="ib-table__number">{{ 'dunning.rate.value'|trans }}</th>
                    <th class="ib-table__number">{{ 'dunning.days'|trans }}</th>
                    <th class="ib-table__number">{{ 'dunning.interest'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for segment in schedule.segments %}
                    <tr>
                        <td>{{ segment.from|date_local }} – {{ segment.until|date_local }}</td>
                        <td class="ib-table__number">{{ segment.amount|money }}</td>
                        <td class="ib-table__number">{{ segment.baseRateBps|percent }}</td>
                        <td class="ib-table__number">{{ segment.pointsBps|percent }}</td>
                        <td class="ib-table__number">{{ segment.rateBps|percent }}</td>
                        <td class="ib-table__number">{{ segment.days }}</td>
                        <td class="ib-table__number">{{ segment.interest|money }}</td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="6">{{ 'dunning.interest'|trans }}</th>
                    <th class="ib-table__number">{{ schedule.total|money }}</th>
                </tr>
            </tfoot>
        </table>
    </div>
{% endif %}
