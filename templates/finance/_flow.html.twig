{#
    Ein Schritt beim Anlegen oder Bearbeiten einer Kostenposition.

    Dieselbe Gestalt wie beim Objekt und beim Mietverhältnis — links die
    Schritte, rechts einer davon. Die Schritte sind Links: jeder hat schon
    gespeichert, es geht also nichts verloren, wenn jemand springt.

    Ein Schritt füllt den Block `fields`.
#}
{% extends 'components/sections.html.twig' %}

{% block section_body %}
    {% if errors.flow is defined %}
        <p class="ib-field__error" role="alert">{{ errors.flow|trans }}</p>
    {% endif %}

    {#
        Was ein eigenes <form> mitbringt und vor den Feldern stehen soll — die
        Jahreswerte. Ein verschachteltes Formular schließt in HTML das äußere,
        und dessen Knöpfe hören auf zu wirken.
    #}
    {% block before_form %}{% endblock %}

    <form method="post" action="{{ action }}">
        <input type="hidden" name="_token" value="{{ csrf_token('finance_item_flow') }}">

        {% block fields %}{% endblock %}

        <div class="ib-flow__actions">
            <a class="ib-button ib-button--quiet" href="{{ cancel }}">{{ 'flow.cancel'|trans }}</a>

            {% if hasPrevious %}
                <button class="ib-button ib-button--quiet" type="submit"
                        name="direction" value="back" formnovalidate>
                    {{ 'flow.back'|trans }}
                </button>
            {% endif %}

            <button class="ib-button" type="submit" name="direction" value="forward">
                {{ isLast ? 'flow.finish'|trans : 'flow.next'|trans }}
            </button>
        </div>
    </form>
{% endblock %}
