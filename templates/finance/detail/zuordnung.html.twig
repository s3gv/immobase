{% extends 'finance/_detail.html.twig' %}
{% set edit_step = 'zuordnung' %}

{% block panel %}
    {% include 'components/table.html.twig' with {
        headers: ['user.review.field'|trans, 'user.review.value'|trans],
        rows: [
            ['finance.item.field.number'|trans, item.number],
            ['finance.item.field.property'|trans, property ? property.oneLine : item.propertyId],
            ['finance.item.field.kind'|trans, item.kind.name],
            ['finance.item.field.key'|trans, item.key.name]
        ],
        empty: ''
    } only %}

    <p class="ib-field__hint">{{ item.key.kind.explanationKey|trans }}</p>
{% endblock %}
