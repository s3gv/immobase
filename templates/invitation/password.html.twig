{% extends 'invitation/_layout.html.twig' %}

{% block step_body %}
    <p class="ib-flow__explanation">{{ 'user.step.password.account'|trans({'%email%': user.email.toString}) }}</p>

    {% include 'components/field.html.twig' with {
        id: 'password', name: 'password', type: 'password',
        label: 'user.field.password'|trans,
        required: true, autofocus: true, autocomplete: 'new-password'
    } only %}

    {% include 'components/field.html.twig' with {
        id: 'repeated', name: 'repeated', type: 'password',
        label: 'user.field.password_repeat'|trans,
        required: true, autocomplete: 'new-password'
    } only %}

    {#
        Die Regeln stehen hier, bevor jemand tippt — nicht erst als
        Fehlermeldung danach. Eine Regel, die man erst beim Scheitern erfährt,
        ist eine Falle.
    #}
    <ul class="ib-rules">
        {% for rule in rules %}
            <li>{{ rule|trans }}</li>
        {% endfor %}
    </ul>
{% endblock %}
